# VCB-Alt environment template
#
# Safe local/private defaults:
VCB_ALT_DATABASE_URL=sqlite:///./data/vcb_alt.db
VCB_ALT_DATA_DIR=./data
VCB_ALT_LOG_DIR=./logs
VCB_ALT_LOG_LEVEL=INFO
VCB_ALT_TIMEZONE=Asia/Seoul

# Data providers:
# - sample: deterministic offline demo data, no network
# - manual: operator-maintained data/snapshots.csv
# - yahoo: automatic end-of-day chart data fetch with local cache
# - stooq: optional CSV fetch; may require STOOQ_API_KEY
# For yahoo/stooq final selection, add operator-verified data/enrichment.csv.
# Price/volume-only scans are blocked by the data-quality gate.
VCB_ALT_DATA_PROVIDER=sample
VCB_ALT_EXTERNAL_API_ENABLED=false
VCB_ALT_MARKET_DATA_TIMEOUT_SECONDS=10
VCB_ALT_MARKET_DATA_CACHE_TTL_HOURS=12
VCB_ALT_STOOQ_API_KEY=

# Provider resilience:
# Retries are intentionally conservative because production scans run in a worker-owned queue.
VCB_ALT_PROVIDER_RETRY_ATTEMPTS=2
VCB_ALT_PROVIDER_RETRY_BACKOFF_SECONDS=0.05
VCB_ALT_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
VCB_ALT_PROVIDER_CIRCUIT_RESET_SECONDS=300
VCB_ALT_PROVIDER_ALPACA_DAILY_BUDGET=2500
VCB_ALT_PROVIDER_FINNHUB_DAILY_BUDGET=500
VCB_ALT_PROVIDER_YAHOO_DAILY_BUDGET=2500
VCB_ALT_PROVIDER_SEC_DAILY_BUDGET=500
VCB_ALT_PROVIDER_OPENAI_DAILY_BUDGET=200
VCB_ALT_PROVIDER_TEMPLATE_DAILY_BUDGET=1000000

# Scan mode:
# - market_universe: primary product mode. Scan the configured market universe,
#   prefilter live movers, enrich top names, then recommend the highest-scoring candidates.
# - watchlist: legacy/manual mode. Evaluate only tickers a user entered.
VCB_ALT_SCAN_MODE=market_universe
VCB_ALT_MARKET_UNIVERSE_PROVIDER=auto
VCB_ALT_MARKET_UNIVERSE_MAX_SYMBOLS=5000
VCB_ALT_MARKET_PREFILTER_LIMIT=30
# Which provider ranks the universe down to the prefilter limit.
# - auto:   Alpaca when its credentials work, otherwise the end-of-day path below
# - alpaca: intraday snapshots, hundreds of symbols per request (needs credentials)
# - yahoo:  end-of-day bars, one request per symbol and therefore capped. Needs no key,
#           so the scan still produces candidates when Alpaca is unavailable.
# - none:   disable prefiltering entirely
VCB_ALT_MARKET_PREFILTER_PROVIDER=auto
VCB_ALT_YAHOO_PREFILTER_MAX_SYMBOLS=150
# Wall-clock stop for the end-of-day prefilter. It costs about a second per symbol, so an
# unbounded run overruns a serverless execution limit. On timeout the scan reports how far
# it got; bars are cached, so running again continues through the universe.
VCB_ALT_PREFILTER_TIME_BUDGET_SECONDS=20
VCB_ALT_MARKET_SNAPSHOT_BATCH_SIZE=100
# Set true in production so the app fails closed instead of recommending sample data.
VCB_ALT_MARKET_SCAN_REQUIRES_LIVE_DATA=false

# Near-real-time/intraday quote layer:
# - none: safe default, no intraday API calls
# - alpaca: fetch latest stock snapshot/quote/minute bar when credentials are configured
VCB_ALT_INTRADAY_DATA_PROVIDER=none
VCB_ALT_INTRADAY_CACHE_TTL_SECONDS=60
VCB_ALT_ALPACA_DATA_FEED=iex
VCB_ALT_ALPACA_API_KEY=
VCB_ALT_ALPACA_API_SECRET=
# After configuring keys, call /api/provider-diagnostics/alpaca with operator access.
# The diagnostics endpoint reports ready/error only and never returns secret values.

# Research data enrichment:
# - csv: use data/enrichment.csv only
# - finnhub: fetch fundamentals, earnings surprise, news, analyst trends, short interest, options, and insider data
# - finnhub_csv: fetch Finnhub first, then let data/enrichment.csv override or fill gaps
VCB_ALT_RESEARCH_DATA_PROVIDER=csv
VCB_ALT_RESEARCH_DATA_CACHE_TTL_HOURS=12
VCB_ALT_FINNHUB_API_KEY=

# SEC filing layer:
# Uses SEC data.sec.gov submissions metadata. Set a real operator contact in SEC_USER_AGENT before enabling.
VCB_ALT_SEC_COMPANY_FACTS_ENABLED=false
VCB_ALT_SEC_USER_AGENT=vcb-alt-stock-screener contact@example.invalid

# AI explanation layer:
# - template: deterministic local summary, no external AI call
# - openai: use the Responses API when VCB_ALT_OPENAI_API_KEY or OPENAI_API_KEY is configured
VCB_ALT_AI_SUMMARY_PROVIDER=template
VCB_ALT_AI_SUMMARY_CACHE_TTL_HOURS=12
VCB_ALT_OPENAI_MODEL=gpt-4.1-mini
VCB_ALT_OPENAI_API_KEY=

# Web service:
# Keep public mode off for local development. For an internet-facing demo,
# set PUBLIC_WEB_ENABLED=true and use a long random token.
VCB_ALT_PUBLIC_WEB_ENABLED=false
VCB_ALT_WEB_ACCESS_TOKEN=replace-with-at-least-16-random-characters
VCB_ALT_AUTO_SEED_SAMPLE=true
# Query-token access is for local/operator trial only. Production SaaS forces this off.
VCB_ALT_ALLOW_QUERY_TOKEN_AUTH=true
# Trust X-Forwarded-For only when the deployment proxy is known to sanitize it.
VCB_ALT_TRUSTED_PROXY_HEADERS=false
VCB_ALT_MAX_JSON_BODY_BYTES=65536

# Public SaaS preparation:
# Keep production mode disabled until PostgreSQL, legal review, support operations,
# and hosted load tests are approved for the target deployment.
VCB_ALT_USER_AUTH_ENABLED=false
VCB_ALT_USER_REGISTRATION_ENABLED=false
VCB_ALT_RATE_LIMIT_PER_MINUTE=120
# Endpoint-specific SaaS limits. Keep these separate so public launch traffic
# can handle many legitimate signups while tenant APIs and worker calls remain bounded.
VCB_ALT_AUTH_RATE_LIMIT_PER_MINUTE=2000
# Login has its own, far tighter bucket. Sharing the signup limit meant roughly 33
# password guesses per second per IP were allowed, which is no brute-force protection.
VCB_ALT_LOGIN_RATE_LIMIT_PER_MINUTE=20
VCB_ALT_USER_RATE_LIMIT_PER_MINUTE=600
VCB_ALT_WORKER_RATE_LIMIT_PER_MINUTE=1200
VCB_ALT_RATE_LIMIT_BACKEND=memory
VCB_ALT_SCAN_QUEUE_ENABLED=false
VCB_ALT_WORKER_CRON_ENABLED=false
VCB_ALT_WORKER_TOKEN=
# On Vercel, set CRON_SECRET to the same value as VCB_ALT_WORKER_TOKEN.
CRON_SECRET=
VCB_ALT_PRODUCTION_SAAS_MODE=false
# Comma-separated emails or users with role=operator/global_operator can read global provider alerts.
VCB_ALT_GLOBAL_OPERATOR_EMAILS=

# Required for public 1000-user SaaS mode:
# VCB_ALT_DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# VCB_ALT_USER_AUTH_ENABLED=true
# VCB_ALT_USER_REGISTRATION_ENABLED=true
# VCB_ALT_RATE_LIMIT_BACKEND=database
# VCB_ALT_SCAN_QUEUE_ENABLED=true
# VCB_ALT_WORKER_CRON_ENABLED=true
# VCB_ALT_WORKER_TOKEN=replace-with-a-long-random-worker-token
# CRON_SECRET=replace-with-the-same-long-random-worker-token
# VCB_ALT_ALLOW_QUERY_TOKEN_AUTH=false
# VCB_ALT_TRUSTED_PROXY_HEADERS=true
# VCB_ALT_GLOBAL_OPERATOR_EMAILS=ops-owner@example.com
# VCB_ALT_PRODUCTION_SAAS_MODE=true
